                        <!-- Маленькие парящие сердечки рядом с котиком -->
                        <text x="245" y="195" font-size="18" class="pulse-heart">💕</text>
                        <text x="135" y="190" font-size="16">✨</text>

                        <!-- Рыжий трогательный котик с букетом и зеленой бабочкой -->
                        <g class="cat-character">
