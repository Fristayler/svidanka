                                <circle cx="52" cy="28" r="8" fill="#fbbf24" stroke="#1c1917" stroke-width="2"/>
                                <circle cx="30" cy="34" r="7" fill="#f97316" stroke="#1c1917" stroke-width="2"/>
                                <circle cx="45" cy="34" r="7" fill="#fb7185" stroke="#1c1917" stroke-width="2"/>
