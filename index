<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Приглашаю на свидание 💌</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;600;700&family=Caveat:wght@600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-cream: #fdf8f5;
            --rose-soft: #fce7f3;
            --berry: #9d174d;
            --warm-orange: #ea580c;
            --forest-green: #15803d;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #fff5f5 0%, #fef6e4 50%, #fce7f3 100%);
            min-height: 100vh;
            overflow-x: hidden;
            color: #4a3531;
        }

        h1, h2, h3, .font-title {
            font-family: 'Comfortaa', cursive;
        }

        .font-handwriting {
            font-family: 'Caveat', cursive;
        }

        /* Парящие сердечки и звездочки на фоне */
        .floating-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .floating-item {
            position: absolute;
            bottom: -50px;
            animation: floatUp linear infinite;
            opacity: 0.55;
            user-select: none;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(0) rotate(0deg) scale(0.8);
                opacity: 0;
            }
            15% {
                opacity: 0.65;
            }
            85% {
                opacity: 0.65;
            }
            100% {
                transform: translateY(-110vh) rotate(360deg) scale(1.2);
                opacity: 0;
            }
        }

        /* Стеклянный эффект для карточек */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 12px 32px -8px rgba(157, 23, 77, 0.12);
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 36px -8px rgba(236, 72, 153, 0.22);
        }

        .event-card.selected {
            border-color: #ec4899;
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(253, 242, 248, 0.96));
            box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.25), 0 16px 32px -8px rgba(236, 72, 153, 0.25);
        }

        /* Анимация котика и часиков */
        @keyframes catBounce {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-4px) rotate(1deg); }
        }
        .cat-character {
            animation: catBounce 3.5s ease-in-out infinite;
        }

        @keyframes pulseHeart {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.12); }
        }
        .pulse-heart {
            animation: pulseHeart 1.8s ease-in-out infinite;
        }

        /* Билетик с перфорацией */
        .ticket-card {
            position: relative;
            background: #fffdf9;
            border: 2px dashed #f472b6;
        }
        .ticket-card::before,
        .ticket-card::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 24px;
            height: 24px;
            background: #fdf2f8;
            border-radius: 50%;
            transform: translateY(-50%);
        }
        .ticket-card::before {
            left: -14px;
            border-right: 2px dashed #f472b6;
        }
        .ticket-card::after {
            right: -14px;
            border-left: 2px dashed #f472b6;
        }

        /* Пользовательский фон, если загружено фото */
        #custom-bg-layer {
            position: fixed;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0.18;
            pointer-events: none;
            z-index: 0;
            transition: opacity 0.5s ease;
        }
    </style>
</head>
