    <!-- Логика приложения и облачное сохранение ответа (Firebase Firestore) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, onSnapshot, doc, setDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Данные о событиях
        const EVENTS_DATA = {
            prince: {
                id: 'prince',
                icon: '👑🌹',
                title: 'Спектакль «Маленький принц»',
                place: 'Театр юного зрителя (ТЮЗ)',
                getDateTime: () => '14.11.26 (суббота) в 17:00'
            },
            ship: {
                id: 'ship',
                icon: '⛵🎶',
                title: 'Мюзикл «Летучий корабль»',
                place: 'Музыкальный театр',
                getDateTime: () => '01.11.26 (воскресенье) в 11:00'
            },
            planetarium: {
                id: 'planetarium',
                icon: '🌌🪐',
                title: '«История одной песчинки»',
                place: 'Планетарий',
                getDateTime: () => window.selectedPlanetariumSlot
            }
        };

        // Состояние выбора
        window.selectedEvents = new Set();
        window.selectedPlanetariumSlot = '25.10.26 (вс) в 10:00';
        window.lastFormattedMessage = '';

        // 1. Создание парящих сердечек на фоне
        function initFloatingHearts() {
            const container = document.getElementById('floating-container');
            const symbols = ['💕', '💖', '✨', '🌸', '💌', '🥰', '🌹', '⭐'];
            for (let i = 0; i < 18; i++) {
                const el = document.createElement('div');
                el.className = 'floating-item';
                el.textContent = symbols[i % symbols.length];
                el.style.left = `${Math.random() * 96}%`;
                el.style.fontSize = `${16 + Math.random() * 16}px`;
                el.style.animationDuration = `${11 + Math.random() * 12}s`;
                el.style.animationDelay = `${Math.random() * 8}s`;
                container.appendChild(el);
            }
        }
        initFloatingHearts();

        // 2. Переключение выбора карточки события
        window.toggleEvent = function(eventId) {
            const card = document.getElementById(`card-${eventId}`);
            const check = document.getElementById(`check-${eventId}`);
            const checkSpan = check.querySelector('span');

            if (window.selectedEvents.has(eventId)) {
                window.selectedEvents.delete(eventId);
                card.classList.remove('selected');
                check.classList.remove('bg-pink-500', 'border-pink-500');
                check.classList.add('bg-white', 'border-pink-300');
                checkSpan.classList.add('opacity-0');
            } else {
                window.selectedEvents.add(eventId);
                card.classList.add('selected');
                check.classList.remove('bg-white', 'border-pink-300');
                check.classList.add('bg-pink-500', 'border-pink-500');
                checkSpan.classList.remove('opacity-0');
            }

            document.getElementById('validation-msg').classList.add('hidden');
        };

        // 3. Выбор даты и времени для Планетария
        window.selectPlanetariumSlot = function(slotText) {
            window.selectedPlanetariumSlot = slotText;
            const btn25 = document.getElementById('slot-oct25');
            const btn29 = document.getElementById('slot-oct29');

            const is25 = slotText.includes('25.10');
            if (is25) {
                btn25.className = 'planet-slot text-left px-3 py-2 rounded-xl border-2 border-pink-400 bg-pink-50/90 text-pink-900 text-xs sm:text-sm font-semibold transition flex items-center justify-between';
                btn25.querySelector('.slot-dot').textContent = '●';
                btn25.querySelector('.slot-dot').className = 'slot-dot text-pink-600';

                btn29.className = 'planet-slot text-left px-3 py-2 rounded-xl border-2 border-stone-200 bg-white/80 text-stone-700 text-xs sm:text-sm font-semibold transition flex items-center justify-between hover:border-pink-300';
                btn29.querySelector('.slot-dot').textContent = '○';
                btn29.querySelector('.slot-dot').className = 'slot-dot text-stone-300';
            } else {
                btn29.className = 'planet-slot text-left px-3 py-2 rounded-xl border-2 border-pink-400 bg-pink-50/90 text-pink-900 text-xs sm:text-sm font-semibold transition flex items-center justify-between';
                btn29.querySelector('.slot-dot').textContent = '●';
                btn29.querySelector('.slot-dot').className = 'slot-dot text-pink-600';

                btn25.className = 'planet-slot text-left px-3 py-2 rounded-xl border-2 border-stone-200 bg-white/80 text-stone-700 text-xs sm:text-sm font-semibold transition flex items-center justify-between hover:border-pink-300';
                btn25.querySelector('.slot-dot').textContent = '○';
                btn25.querySelector('.slot-dot').className = 'slot-dot text-stone-300';
            }

            // Если карточка планетария ещё не была выбрана — автоматически отмечаем её
            if (!window.selectedEvents.has('planetarium')) {
                window.toggleEvent('planetarium');
            }
        };

        // 4. Добавление быстрого пожелания в поле комментария
        window.addQuickWish = function(text) {
            const textarea = document.getElementById('wish-comment');
            if (textarea.value.trim().length > 0) {
                if (!textarea.value.includes(text)) {
                    textarea.value = textarea.value.trim() + ' ' + text;
                }
            } else {
                textarea.value = text;
            }
        };

        // 5. Праздничный салют из сердечек при нажатии "Я согласна!"
        function launchHeartConfetti() {
            const emojis = ['💖', '💕', '💘', '🥰', '✨', '🌸', '🎉'];
            for (let i = 0; i < 36; i++) {
                const heart = document.createElement('div');
                heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                heart.style.position = 'fixed';
                heart.style.left = `${50 + (Math.random() - 0.5) * 60}%`;
                heart.style.top = '65%';
                heart.style.fontSize = `${20 + Math.random() * 18}px`;
                heart.style.pointerEvents = 'none';
                heart.style.zIndex = '100';
                heart.style.transition = 'all 1.4s cubic-bezier(0.16, 1, 0.3, 1)';
                document.body.appendChild(heart);

                requestAnimationFrame(() => {
                    const angle = (Math.random() - 0.5) * 320;
                    const lift = -180 - Math.random() * 280;
                    heart.style.transform = `translate(${angle}px, ${lift}px) rotate(${(Math.random() - 0.5) * 180}deg) scale(1.2)`;
                    heart.style.opacity = '0';
                });

                setTimeout(() => heart.remove(), 1500);
            }
        }

        // 6. Подтверждение выбора, генерация билетика и сохранение в облако
        window.confirmDateChoice = async function() {
            if (window.selectedEvents.size === 0) {
                const msg = document.getElementById('validation-msg');
                msg.classList.remove('hidden');
                msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            launchHeartConfetti();

            const chosenItems = Array.from(window.selectedEvents).map(id => {
                const ev = EVENTS_DATA[id];
                return {
                    id: ev.id,
                    icon: ev.icon,
                    title: ev.title,
                    place: ev.place,
                    dateTime: ev.getDateTime()
                };
            });

            const wishText = document.getElementById('wish-comment').value.trim();

            // Отрисовка внутри билетика
            const summaryContainer = document.getElementById('ticket-events-summary');
            summaryContainer.innerHTML = chosenItems.map(item => `
                <div class="flex items-center gap-3.5 bg-rose-50/70 border border-pink-200/80 rounded-2xl p-3.5">
                    <div class="text-2xl">${item.icon}</div>
                    <div class="flex-1">
                        <div class="font-bold text-stone-800 text-sm sm:text-base">${item.title}</div>
                        <div class="text-xs text-rose-700 font-semibold">${item.place} • ${item.dateTime}</div>
                    </div>
                    <div class="text-lg">✅</div>
                </div>
            `).join('');

            const wishBox = document.getElementById('ticket-wish-box');
            if (wishText) {
                document.getElementById('ticket-wish-text').textContent = wishText;
                wishBox.classList.remove('hidden');
            } else {
                wishBox.classList.add('hidden');
            }

            // Формирование красивого текста для Telegram / WhatsApp / буфера обмена
            const lines = [
                '💌 Я с радостью принимаю твоё приглашение на свидание! 🥰💖',
                '',
                '✨ Мой выбор:'
            ];
            chosenItems.forEach(item => {
                lines.push(`${item.icon} ${item.title} — ${item.place} (${item.dateTime})`);
            });
            if (wishText) {
                lines.push('');
                lines.push(`🧁 Пожелание: ${wishText}`);
            }
            lines.push('');
            lines.push('Жду нашей встречи! 💕');

            window.lastFormattedMessage = lines.join('\n');
            const encodedText = encodeURIComponent(window.lastFormattedMessage);

            document.getElementById('tg-share-link').href = `https://t.me/share/url?url=${encodeURIComponent(window.location.href)}&text=${encodedText}`;
            document.getElementById('wa-share-link').href = `https://wa.me/?text=${encodedText}`;

            const resultSection = document.getElementById('result-section');
            resultSection.classList.remove('hidden');
            resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

            // Сохранение ответа в Firestore, чтобы отправитель сразу увидел его в панели
            await saveResponseToCloud(chosenItems, wishText);
        };

        // 7. Копирование текста ответа
        window.copyResponseText = function() {
            if (!window.lastFormattedMessage) return;
            const tempInput = document.createElement('textarea');
            tempInput.value = window.lastFormattedMessage;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            const btnText = document.getElementById('copy-btn-text');
            btnText.textContent = 'Скопировано в буфер обмена! 💖';
            setTimeout(() => {
                btnText.textContent = 'Скопировать красивый текст ответа';
            }, 3000);
        };

        // 8. Управление модальным окном фото/фона
        window.togglePhotoModal = function() {
            const modal = document.getElementById('photo-modal');
            modal.classList.toggle('hidden');
        };

        window.applyImageSource = function(srcData) {
            if (!srcData) return;
            const postcardImg = document.getElementById('user-postcard-img');
            const illustrated = document.getElementById('illustrated-postcard');
            const bgLayer = document.getElementById('custom-bg-layer');

            postcardImg.src = srcData;
            postcardImg.classList.remove('hidden');
            illustrated.classList.add('hidden');
            bgLayer.style.backgroundImage = `url('${srcData}')`;
        };

        window.handleFileUpload = function(event) {
            const file = event.target.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                window.applyImageSource(e.target.result);
            };
            reader.readAsDataURL(file);
        };

        window.applyUrlImage = function() {
            const url = document.getElementById('photo-url-input').value.trim();
            if (url) {
                window.applyImageSource(url);
                window.togglePhotoModal();
            }
        };

        window.resetToIllustratedCat = function() {
            const postcardImg = document.getElementById('user-postcard-img');
            const illustrated = document.getElementById('illustrated-postcard');
            const bgLayer = document.getElementById('custom-bg-layer');

            postcardImg.classList.add('hidden');
            illustrated.classList.remove('hidden');
            bgLayer.style.backgroundImage = 'none';
        };

        window.toggleResponsesPanel = function() {
            const panel = document.getElementById('responses-panel');
            panel.classList.toggle('hidden');
        };

        // 9. Подключение Firebase для мгновенного получения ответа
        let db = null;
        let auth = null;
        let currentUser = null;
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'date-invite-app';

        async function initCloudSync() {
            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) return;
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (user) {
                        listenForResponses();
                    }
                });
            } catch (err) {
                console.warn('Cloud sync fallback mode:', err);
            }
        }

        async function saveResponseToCloud(chosenItems, wishText) {
            if (!db || !currentUser) return;
            try {
                const responsesRef = collection(db, 'artifacts', appId, 'public', 'data', 'date_responses');
                await addDoc(responsesRef, {
                    choicesJson: JSON.stringify(chosenItems),
                    wish: wishText || '',
                    createdAt: new Date().toLocaleString('ru-RU'),
                    timestamp: Date.now()
                });
            } catch (e) {
                console.warn('Could not save response to cloud:', e);
            }
        }

        function listenForResponses() {
            if (!db || !currentUser) return;
            const responsesRef = collection(db, 'artifacts', appId, 'public', 'data', 'date_responses');
            onSnapshot(responsesRef, (snapshot) => {
                const items = [];
                snapshot.forEach(docSnap => {
                    const data = docSnap.data();
                    let parsedChoices = [];
                    try {
                        parsedChoices = JSON.parse(data.choicesJson || '[]');
                    } catch (e) {}
                    items.push({
                        id: docSnap.id,
                        choices: parsedChoices,
                        wish: data.wish,
                        createdAt: data.createdAt,
                        timestamp: data.timestamp || 0
                    });
                });

                items.sort((a, b) => b.timestamp - a.timestamp);

                const badge = document.getElementById('responses-count-badge');
                badge.textContent = items.length;

                const listEl = document.getElementById('saved-responses-list');
                if (items.length === 0) {
                    listEl.innerHTML = `<p class="text-stone-400 italic py-2">Пока ответов нет — ждём её заветного выбора! 💕</p>`;
                    return;
                }

                listEl.innerHTML = items.map(entry => `
                    <div class="bg-white/90 border border-pink-200 rounded-2xl p-3.5 shadow-sm">
                        <div class="flex justify-between items-center text-[11px] text-rose-700 font-bold mb-1.5">
                            <span>💖 Получен ответ!</span>
                            <span>${entry.createdAt || ''}</span>
                        </div>
                        <div class="space-y-1 mb-1.5">
                            ${entry.choices.map(c => `
                                <div class="text-xs font-semibold text-stone-800">
                                    ${c.icon} ${c.title} — <span class="text-rose-700">${c.place} (${c.dateTime})</span>
                                </div>
                            `).join('')}
                        </div>
                        ${entry.wish ? `<div class="text-xs text-stone-600 bg-pink-50/70 rounded-xl px-2.5 py-1.5 mt-1">💌 «${entry.wish}»</div>` : ''}
                    </div>
                `).join('');
            }, (error) => {
                console.warn('Snapshot listener error:', error);
            });
        }

        initCloudSync();
    </script>
</body>
</html>